  <DataSets>
    <DataSet Name="DS_Continentes">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT Codigo, Nombre
FROM (VALUES ('NA','Norteamérica'),('EU','Europa'),('AS','Asia'),
             ('OC','Oceanía'),('SA','Sudamérica'),('AF','África'),
             ('AN','Antártida'),('ND','Sin continente / no identificado')) c(Codigo, Nombre);</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Codigo">
          <DataField>Codigo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Nombre">
          <DataField>Nombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_R1_Indicadores">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Continente">
            <Value>=Parameters!Continente.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
    COUNT(*)                                                          AS TotalVuelos,
    SUM(CAST(f.EsRutaOfertada AS INT)) * 1.0 / COUNT(*)               AS PctRutaOfertada,      -- KPI meta 0.50
    SUM(CASE WHEN f.EsInternacional = 1 THEN 1 ELSE 0 END) * 1.0
      / NULLIF(SUM(CASE WHEN f.EsInternacional IS NOT NULL THEN 1 ELSE 0 END), 0)
                                                                      AS PctInternacional,
    SUM(f.PasajerosEstimados)                                         AS PasajerosEstimados,
    SUM(f.IngresoEstimadoUSD)                                         AS IngresoEstimadoUSD,
    SUM(f.PasajerosEstimados) * 1.0 / NULLIF(SUM(f.AsientosDisponibles), 0)
                                                                      AS OcupacionPromedio,
    AVG(CAST(f.DistanciaKm AS DECIMAL(12,2)))                         AS DistanciaPromedioKm,
    1 - SUM(CASE WHEN f.AeropuertoOrigenKey = -1 THEN 1 ELSE 0 END) * 1.0 / COUNT(*)
                                                                      AS PctIdentAeropuerto,   -- KPI meta 0.95
    1 - SUM(CASE WHEN f.AerolineaKey = -1 THEN 1 ELSE 0 END) * 1.0 / COUNT(*)
                                                                      AS PctIdentAerolinea     -- KPI meta 0.70
FROM dbo.FactVuelos f
JOIN dbo.DimAeropuerto o ON o.AeropuertoKey = f.AeropuertoOrigenKey
WHERE ISNULL(o.Continente, 'ND') IN (@Continente);</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="TotalVuelos">
          <DataField>TotalVuelos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PctRutaOfertada">
          <DataField>PctRutaOfertada</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="PctInternacional">
          <DataField>PctInternacional</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="PasajerosEstimados">
          <DataField>PasajerosEstimados</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="IngresoEstimadoUSD">
          <DataField>IngresoEstimadoUSD</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="OcupacionPromedio">
          <DataField>OcupacionPromedio</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="DistanciaPromedioKm">
          <DataField>DistanciaPromedioKm</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="PctIdentAeropuerto">
          <DataField>PctIdentAeropuerto</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="PctIdentAerolinea">
          <DataField>PctIdentAerolinea</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_R1_TendenciaDiaria">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Continente">
            <Value>=Parameters!Continente.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
    d.Fecha,
    d.NombreDia,
    d.EsFinDeSemana,
    COUNT(*)                                            AS Vuelos,
    SUM(CAST(f.EsRutaOfertada AS INT)) * 1.0 / COUNT(*) AS PctRutaOfertada
FROM dbo.FactVuelos f
JOIN dbo.DimFecha      d ON d.FechaKey      = f.FechaKey
JOIN dbo.DimAeropuerto o ON o.AeropuertoKey = f.AeropuertoOrigenKey
WHERE ISNULL(o.Continente, 'ND') IN (@Continente)
GROUP BY d.Fecha, d.NombreDia, d.EsFinDeSemana
ORDER BY d.Fecha;</CommandText>
      </Query>
      <Fields>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="NombreDia">
          <DataField>NombreDia</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EsFinDeSemana">
          <DataField>EsFinDeSemana</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="Vuelos">
          <DataField>Vuelos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PctRutaOfertada">
          <DataField>PctRutaOfertada</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_R1_PorContinente">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Continente">
            <Value>=Parameters!Continente.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
    CASE ISNULL(o.Continente,'ND')
         WHEN 'NA' THEN 'Norteamérica' WHEN 'EU' THEN 'Europa' WHEN 'AS' THEN 'Asia'
         WHEN 'OC' THEN 'Oceanía'      WHEN 'SA' THEN 'Sudamérica' WHEN 'AF' THEN 'África'
         WHEN 'AN' THEN 'Antártida'    ELSE 'Sin continente' END       AS Continente,
    COUNT(*)                                                           AS Vuelos,
    COUNT(*) * 1.0 / SUM(COUNT(*)) OVER ()                             AS Participacion
FROM dbo.FactVuelos f
JOIN dbo.DimAeropuerto o ON o.AeropuertoKey = f.AeropuertoOrigenKey
WHERE ISNULL(o.Continente, 'ND') IN (@Continente)
GROUP BY ISNULL(o.Continente,'ND')
ORDER BY Vuelos DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="Continente">
          <DataField>Continente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vuelos">
          <DataField>Vuelos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Participacion">
          <DataField>Participacion</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
