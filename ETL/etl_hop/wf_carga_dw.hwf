      <name>52 Enriquecer aeropuertos</name>
      <description>Ejecuta sql/52_enriquecer_aeropuertos.sql</description>
      <type>SQL</type>
      <attributes/>
      <sql/>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>T</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/sql/52_enriquecer_aeropuertos.sql</sqlfilename>
      <sendOneStatement>F</sendOneStatement>
      <connection>dw_postgres</connection>
      <parallel>N</parallel>
      <xloc>448</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>60 DimAvion</name>
      <description>Ejecuta sql/60_dim_avion.sql</description>
      <type>SQL</type>
      <attributes/>
      <sql/>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>T</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/sql/60_dim_avion.sql</sqlfilename>
      <sendOneStatement>F</sendOneStatement>
      <connection>dw_postgres</connection>
      <parallel>N</parallel>
      <xloc>640</xloc>
