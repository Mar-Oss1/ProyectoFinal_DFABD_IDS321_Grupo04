    <action>
      <name>80 Log de carga</name>
      <description>Ejecuta sql/80_log_carga.sql</description>
      <type>SQL</type>
      <attributes/>
      <sql/>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>T</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/sql/80_log_carga.sql</sqlfilename>
      <sendOneStatement>F</sendOneStatement>
