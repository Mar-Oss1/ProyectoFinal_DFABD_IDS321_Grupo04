      <attributes_hac/>
    </action>
    <action>
      <name>70 FactVuelos</name>
      <description>Ejecuta sql/70_fact_vuelos.sql</description>
      <type>SQL</type>
      <attributes/>
      <sql/>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>T</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/sql/70_fact_vuelos.sql</sqlfilename>
      <sendOneStatement>F</sendOneStatement>
      <connection>dw_postgres</connection>
      <parallel>N</parallel>
      <xloc>832</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
