  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Cargar staging (p01)</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Cargar staging (p01)</from>
      <to>10 Dedup staging</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>10 Dedup staging</from>
      <to>20 Limpiar DW</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>20 Limpiar DW</from>
      <to>30 Rutas ofertadas</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>30 Rutas ofertadas</from>
      <to>40 DimAerolinea</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>40 DimAerolinea</from>
      <to>50 DimAeropuerto OurAirports</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>50 DimAeropuerto OurAirports</from>
      <to>51 DimAeropuerto OpenFlights</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>51 DimAeropuerto OpenFlights</from>
      <to>52 Enriquecer aeropuertos</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>52 Enriquecer aeropuertos</from>
      <to>60 DimAvion</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>60 DimAvion</from>
      <to>70 FactVuelos</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>70 FactVuelos</from>
      <to>80 Log de carga</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>
