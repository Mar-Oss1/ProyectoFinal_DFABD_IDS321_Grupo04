      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F57EC16-C933-484A-B70C-E96F37BCF62A}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE dbo.xw_rutas_icao; INSERT INTO dbo.xw_rutas_icao&#xA;                                                                                                             (origen, destino)&#xA;                                                                                    SELECT DISTINCT so.icao, sd.icao&#xA;                                                                                    FROM            OpenFlights.dbo.routes r JOIN&#xA;                                                                                                             OpenFlights.dbo.airports so ON so.airport_id = r.source_airport_id JOIN&#xA;                                                                                                             OpenFlights.dbo.airports sd ON sd.airport_id = r.dest_airport_id&#xA;                                                                                    WHERE        so.icao IS NOT NULL AND sd.icao IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
