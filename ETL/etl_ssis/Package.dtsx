            <component
              refId="Package\DF_DimAeropuerto_OA\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT ident, ICAO, IATA, name, municipality, iso_country, iso_region,
       region_nombre, continent, latitude_deg, longitude_deg,
       elevation_ft, type, scheduled_service
FROM (
    SELECT CAST(a.ident AS VARCHAR(20)) AS ident,
           COALESCE(NULLIF(a.icao_code,''), NULLIF(a.gps_code,'')) AS ICAO,
           NULLIF(a.iata_code,'') AS IATA,
           a.name, a.municipality, a.iso_country, a.iso_region,
           r.name AS region_nombre, a.continent,
           a.latitude_deg, a.longitude_deg, a.elevation_ft, a.type, a.scheduled_service,
           ROW_NUMBER() OVER (
               PARTITION BY COALESCE(NULLIF(a.icao_code,''), NULLIF(a.gps_code,''), a.ident)
               ORDER BY CASE WHEN a.scheduled_service='yes' THEN 0 ELSE 1 END, a.id) AS rn
    FROM dbo.oa_stg_airports a
    OUTER APPLY (SELECT TOP 1 name FROM dbo.oa_stg_regions r WHERE r.code = a.iso_region) r
) x
WHERE x.rn = 1</property>
