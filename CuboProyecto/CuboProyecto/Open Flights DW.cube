  <Source dwd:design-time-name="d632a504-9b18-4e07-8145-8e5f877d2f54">
    <DataSourceViewID>Open Flights DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="d0eb39be-aef7-47d3-ab9f-db7e011ddb6f">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T06:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T06:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
El comando CALCULATE controla la agregación de celdas hoja en el cubo.
Si se elimina o modifica el comando CALCULATE, se ven afectados los datos del cubo.
Solo debe editar este comando si especifica manualmente cómo se agrega el cubo.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Ocupacion Promedio Estimada]
 AS IIF([Measures].[Asientos Disponibles] = 0, NULL,
    [Measures].[Pasajeros Estimados] / [Measures].[Asientos Disponibles]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Ingreso Estimado por Vuelo]
 AS IIF([Measures].[Cantidad Vuelos] = 0, NULL,
    [Measures].[Ingreso Estimado USD] / [Measures].[Cantidad Vuelos]), 
FORMAT_STRING = "Currency", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[% Origen No Identificado]
 AS IIF([Measures].[Cantidad Vuelos] = 0, NULL,
    ([Measures].[Cantidad Vuelos], [Aeropuerto Origen].[Aeropuerto Key].&amp;[-1])
    / [Measures].[Cantidad Vuelos]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[% Destino No Identificado]
 AS IIF([Measures].[Cantidad Vuelos] = 0, NULL,
    ([Measures].[Cantidad Vuelos], [Aeropuerto Destino].[Aeropuerto Key].&amp;[-1])
    / [Measures].[Cantidad Vuelos]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[% Aerolinea No Identificada]
 AS IIF([Measures].[Cantidad Vuelos] = 0, NULL,
    ([Measures].[Cantidad Vuelos], [Dim Aerolinea].[Aerolinea Key].&amp;[-1])
    / [Measures].[Cantidad Vuelos]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[% Avion No Identificado]
 AS IIF([Measures].[Cantidad Vuelos] = 0, NULL,
    ([Measures].[Cantidad Vuelos], [Dim Avion].[Avion Key].&amp;[-1])
    / [Measures].[Cantidad Vuelos]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos'  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Distancia Promedio Km]
 AS IIF([Measures].[Cantidad Vuelos] = 0, NULL,
    [Measures].[Distancia Km] / [Measures].[Cantidad Vuelos]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos';  
CREATE MEMBER CURRENTCUBE.[Measures].[Duracion Promedio Min]
 AS IIF([Measures].[Cantidad Vuelos] = 0, NULL,
    [Measures].[Duracion Minutos] / [Measures].[Cantidad Vuelos]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos';   
CREATE MEMBER CURRENTCUBE.[Measures].[Promedio Vuelos por Dia]
 AS IIF(COUNT(NONEMPTY(EXISTING [Dim Fecha].[Fecha].[Fecha].MEMBERS,
                     [Measures].[Cantidad Vuelos])) = 0, NULL,
      [Measures].[Cantidad Vuelos] /
      COUNT(NONEMPTY(EXISTING [Dim Fecha].[Fecha].[Fecha].MEMBERS,
                     [Measures].[Cantidad Vuelos]))), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos';    
CREATE MEMBER CURRENTCUBE.[Measures].[% Participacion Aerolinea]
 AS IIF(([Measures].[Cantidad Vuelos], ROOT([Dim Aerolinea])) = 0, NULL,
    [Measures].[Cantidad Vuelos] /
    ([Measures].[Cantidad Vuelos], ROOT([Dim Aerolinea]))), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos';    
CREATE MEMBER CURRENTCUBE.[Measures].[% Participacion Avion]
 AS IIF(([Measures].[Cantidad Vuelos], ROOT([Dim Avion])) = 0, NULL,
    [Measures].[Cantidad Vuelos] /
    ([Measures].[Cantidad Vuelos], ROOT([Dim Avion]))), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos';     

CREATE MEMBER CURRENTCUBE.[Measures].[Vuelos Nacionales]
 AS [Measures].[Vuelos Pais Conocido] - [Measures].[Vuelos Internacionales], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos';     
CREATE MEMBER CURRENTCUBE.[Measures].[% Vuelos Internacionales]
 AS IIF([Measures].[Vuelos Pais Conocido] = 0, NULL,
    [Measures].[Vuelos Internacionales] / [Measures].[Vuelos Pais Conocido]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos';     

CREATE MEMBER CURRENTCUBE.[Measures].[% Participacion Trafico]
 AS IIF(([Measures].[Cantidad Vuelos], ROOT([Aeropuerto Origen])) = 0, NULL,
      [Measures].[Cantidad Vuelos] /
      ([Measures].[Cantidad Vuelos], ROOT([Aeropuerto Origen]))),
FORMAT_STRING = "Percent",
VISIBLE = 1 , ASSOCIATED_MEASURE_GROUP = 'Fact Vuelos'; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="7c996d4a-09b6-4422-a679-49a2aeacf166">
      <ID>KPI</ID>
      <Name>Rutas Ofertadas</Name>
      <AssociatedMeasureGroupID>Fact Vuelos</AssociatedMeasureGroupID>
      <Value>  IIF([Measures].[Cantidad Vuelos] = 0, NULL,
      [Measures].[Vuelos Ruta Ofertada] / [Measures].[Cantidad Vuelos])</Value>
      <Goal>0.5</Goal>
      <Status>  CASE
      WHEN KPIVALUE("Rutas Ofertadas") &gt;= KPIGOAL("Rutas Ofertadas") THEN 1
      WHEN KPIVALUE("Rutas Ofertadas") &gt;= KPIGOAL("Rutas Ofertadas") * 0.8 THEN 0
      ELSE -1
  END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>